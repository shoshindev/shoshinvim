[
  {
    "id": "typescript",
    "label": "TypeScript & JavaScript",
    "short": "TypeScript",
    "group": "Web",
    "recommended": true,
    "server": {
      "name": "ts_ls",
      "command": "typescript-language-server",
      "args": [
        "--stdio"
      ],
      "package": "typescript-language-server",
      "needs": [
        "node"
      ],
      "filetypes": [
        "javascript",
        "javascriptreact",
        "typescript",
        "typescriptreact"
      ],
      "roots": [
        "tsconfig.json",
        "jsconfig.json",
        "package.json",
        ".git"
      ],
      "basic": "init_options = { hostInfo = 'neovim' }, root_dir = function(bufnr, on_dir)\n  if vim.fs.root(bufnr, { 'deno.json', 'deno.jsonc' }) then return end\n  on_dir(vim.fs.root(bufnr, { 'tsconfig.json', 'jsconfig.json', 'package.json', '.git' }) or vim.fn.getcwd())\nend,"
    },
    "formatter": {
      "name": "prettier",
      "command": "prettier",
      "filetypes": [
        "javascript",
        "javascriptreact",
        "typescript",
        "typescriptreact"
      ],
      "package": "prettier",
      "needs": [
        "node"
      ],
      "label": "Prettier"
    },
    "parsers": [
      "javascript",
      "jsdoc",
      "tsx",
      "typescript"
    ]
  },
